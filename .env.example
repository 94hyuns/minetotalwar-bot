# 영지전 디스코드 봇 설정. 이 파일을 .env 로 복사해 채운다 (.env 는 깃에 올리지 않음).

# 디스코드 개발자 포털 → Bot → Reset Token 으로 받은 봇 토큰
DISCORD_TOKEN=

# 디스코드 서버(길드) ID와 채널 ID (개발자 모드 켜고 우클릭 → ID 복사)
GUILD_ID=
CHANNEL_BUG=
CHANNEL_SUGGEST=
CHANNEL_RANKING=
CHANNEL_GUIDE=

# GitHub 토큰 (fine-grained: 해당 저장소 Issues 읽기/쓰기 — 이슈·댓글·라벨 확인중/보류) 과 저장소
GITHUB_TOKEN=
GITHUB_REPO=94hyuns/minetotalwar-bot

# 모드 서버가 factions.json·status.json 을 쓰는 폴더
EXPORT_DIR=../minetotalwar/export

# 가이드 파일. 저장소에서 바로 돌리면 ../docs/가이드.md (기본값),
# 운영 서버는 tools/deploy_bot.ps1 이 ~/minetotalwar-bot/가이드.md 로 복사하므로 아래처럼 둔다.
GUIDE_PATH=./가이드.md

# 봇 상태 파일 (이슈↔스레드 대응, 순위·가이드 메시지 ID)
STATE_PATH=./state.json

# 버그 처리 방식: list(기본) = 접수(이슈 + 스레드)까지만, 운영자가 이슈 탭에서 처리
#                 auto = 운영자의 Claude Code 세션이 30분마다 가져가 재현·수정·배포 (README "Claude 세션 연결")
BUG_MODE=list

# #서버공지 웹훅 주소 (매주 월요일 지난 주 제보 집계 한 줄). 비우면 안 보냄
NOTICE_WEBHOOK=

# 모드 제작자 공개 이슈 저장소 (owner/name). /상류 · 이슈 라벨 `상류` 로 이쪽에 이슈를 연다. 비우면 꺼짐
UPSTREAM_REPO=94hyuns/minetotalwar-bot

# #버그제보 를 작성자만 보이는 비공개 스레드로 옮기고 원글을 지움 (기본 true). false 면 원글에 공개 스레드
BUG_PRIVATE=true
